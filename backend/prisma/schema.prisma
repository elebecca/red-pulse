generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model test_game {
  id        Int      @id @default(autoincrement())
  game_name String   @db.VarChar(100)
  provider  String?  @db.VarChar(100)
  is_active Boolean? @default(true)
}
